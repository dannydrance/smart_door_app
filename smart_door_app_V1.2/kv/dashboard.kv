#:import dp kivy.metrics.dp
#:import sp kivy.metrics.sp

<DashboardScreen>:
    BoxLayout:
        orientation: 'vertical'
        canvas.before:
            Color:
                rgba: 0.12, 0.15, 0.2, 1
            Rectangle:
                pos: self.pos
                size: self.size

        # ================= HEADER BAR =================
        BoxLayout:
            size_hint_y: None
            height: dp(60)
            padding: [dp(15), dp(10)]
            spacing: dp(10)
            canvas.before:
                Color:
                    rgba: 0.18, 0.22, 0.28, 1
                Rectangle:
                    pos: self.pos
                    size: self.size

            Label:
                text: "Smart Door Control"
                font_size: sp(20)
                bold: True
                color: 1, 1, 1, 1
                halign: "left"
                valign: "middle"
                text_size: self.size

            Widget:

            Button:
                id: profile_btn
                text: "Menu ▾"
                font_size: sp(14)
                size_hint_x: None
                width: dp(120)
                background_normal: ''
                background_color: 0.25, 0.5, 0.9, 1
                color: 1, 1, 1, 1
                bold: True
                on_release: root.open_menu(self)

        # ================= MAIN CONTENT =================
        BoxLayout:
            orientation: 'vertical'
            padding: [dp(15), dp(10)]
            spacing: dp(12)

            # ---- STATUS BAR ----
            BoxLayout:
                size_hint_y: None
                height: dp(40)
                spacing: dp(10)

                Label:
                    id: connection_label
                    text: "MQTT: " + root.connection_status
                    color: (0, 1, 0, 1) if root.connection_status == "Online" else (1, 0.3, 0.3, 1)
                    font_size: sp(14)
                    bold: True

                Label:
                    id: status_label
                    text: "Device Offline"
                    color: (0, 1, 0, 1) if root.connection_status == "Device Online" else (1, 0.3, 0.3, 1)
                    font_size: sp(14)
                    bold: True

                Label:
                    id: wifi_label
                    text: "Signal: -- dBm"
                    color: 0.8, 0.8, 0.8, 1
                    font_size: sp(12)

            # ---- DOOR + CONTROL BAR ----
            BoxLayout:
                size_hint_y: None
                height: dp(55)
                spacing: dp(12)

                Button:
                    text: "UNLOCK"
                    background_normal: ''
                    background_color: 0.2, 0.8, 0.4, 1
                    color: 1, 1, 1, 1
                    font_size: sp(16)
                    bold: True
                    on_release: root.send_command("UNLOCK")

                Button:
                    text: "LOCK"
                    background_normal: ''
                    background_color: 0.9, 0.2, 0.2, 1
                    color: 1, 1, 1, 1
                    font_size: sp(16)
                    bold: True
                    on_release: root.send_command("LOCK")

                Button:
                    text: "Manage"
                    background_normal: ''
                    background_color: 0.2, 0.6, 0.9, 1
                    color: 1, 1, 1, 1
                    font_size: sp(16)
                    bold: True
                    on_release: app.root.current = "manage"

            #----- NOTIFICATIONS SECTION ----
            BoxLayout:
                orientation: 'vertical'
                spacing: dp(5)
                padding: [0, dp(5), 0, dp(10)]

                BoxLayout:
                    orientation: 'horizontal'
                    size_hint_y: None
                    height: dp(40)
                    spacing: dp(10)

                    Label:
                        text: "Notifications"
                        font_size: sp(16)
                        bold: True
                        color: 1, 1, 1, 1
                        size_hint_y: None
                        height: dp(30)
                        halign: 'left'
                        valign: 'middle'
                        text_size: self.size
                        size_hint_x: 0.5

                    AnchorLayout:
                        size_hint_x: 0.5
                        anchor_x: 'right'
                        anchor_y: 'center'

                        Button:
                            text: "Clear Notifications"
                            size_hint: None, None
                            size: dp(140), dp(35)
                            background_normal: ''
                            background_color: 0.5, 0.2, 0.2, 1
                            color: 1, 1, 1, 1
                            font_size: sp(12)
                            bold: True
                            on_release: root.clear_notifications()

                ScrollView:
                    id: notification_scroll
                    do_scroll_x: False
                    bar_width: dp(8)

                    BoxLayout:
                        id: notification_list
                        orientation: "vertical"
                        size_hint_y: None
                        height: self.minimum_height
                        spacing: dp(8)
                        padding: [dp(5), dp(5)]
                        size_hint_x: 1