#:import dp kivy.metrics.dp
#:import sp kivy.metrics.sp

<LoginScreen>:
    BoxLayout:
        orientation: 'vertical'
        padding: [dp(30), dp(50), dp(30), dp(30)]
        spacing: dp(20)
        canvas.before:
            Color:
                rgba: 0.1, 0.15, 0.2, 1
            Rectangle:
                pos: self.pos
                size: self.size

        Label:
            text: "IOT-BASED SMART LOCKER\nSECURITY SYSTEM"
            font_size: sp(24)
            bold: True
            color: 1,1,1,1
            halign: 'center'     
            valign: 'middle'     
            text_size: self.size 

        # Username input
        TextInput:
            id: username
            hint_text: "Username"
            multiline: False
            size_hint_y: None
            height: dp(50)
            padding: [dp(15), dp(15)]
            background_normal: ''
            background_active: ''
            background_color: 0.3,0.3,0.35,1
            foreground_color: 1,1,1,1
            cursor_color: 1,1,1,1
            font_size: sp(16)

        # Password input
        TextInput:
            id: password
            hint_text: "Password"
            multiline: False
            password: True
            size_hint_y: None
            height: dp(50)
            padding: [dp(15), dp(15)]
            background_normal: ''
            background_active: ''
            background_color: 0.3,0.3,0.35,1
            foreground_color: 1,1,1,1
            cursor_color: 1,1,1,1
            font_size: sp(16)

        # Error label
        Label:
            id: error
            color: 1,0.3,0.3,1
            text: ""
            font_size: sp(14)
            size_hint_y: None
            height: dp(30)

        # Login button
        Button:
            text: "Login"
            font_size: sp(18)
            size_hint_y: None
            height: dp(50)
            background_normal: ''
            background_color: 0.2, 0.6, 0.9, 1
            color: 1,1,1,1
            bold: True
            border: (12,12,12,12)
            on_release: root.validate_user()