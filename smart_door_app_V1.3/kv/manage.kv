#:import dp kivy.metrics.dp
#:import sp kivy.metrics.sp

<ManageScreen>:
    BoxLayout:
        orientation: 'vertical'
        canvas.before:
            Color:
                rgba: 0.12, 0.15, 0.2, 1
            Rectangle:
                group: 'background'
                pos: self.pos
                size: self.size

        # ============ HEADER BAR ============
        BoxLayout:
            size_hint_y: None
            height: dp(60)
            padding: [dp(15), dp(10)]
            spacing: dp(10)
            canvas.before:
                Color:
                    rgba: 0.18, 0.22, 0.28, 1
                Rectangle:
                    pos: self.pos
                    size: self.size

            Label:
                text: "Manage Access"
                font_size: sp(20)
                bold: True
                color: 1, 1, 1, 1
                halign: "left"
                valign: "middle"
                text_size: self.size

            Widget:

            Button:
                id: menu_btn
                text: "Menu"
                font_size: sp(14)
                size_hint_x: None
                width: dp(120)
                background_normal: ''
                background_color: 0.25, 0.5, 0.9, 1
                color: 1, 1, 1, 1
                bold: True
                on_release: root.open_menu(self)

        # ============ MAIN CONTENT (SCROLLABLE) ============
        ScrollView:
            do_scroll_x: False
            do_scroll_y: True
            bar_width: dp(8)
            
            BoxLayout:
                orientation: 'vertical'
                padding: [dp(15), dp(10)]
                spacing: dp(15)
                size_hint_y: None
                height: self.minimum_height

                Label:
                    id: feedback
                    text: ""
                    font_size: sp(14)
                    color: 0.8, 0.8, 1, 1
                    size_hint_y: None
                    height: dp(30)
                    text_size: self.width, None
                    halign: "left"
                    valign: "middle"

                # ============ RFID CARD SECTION ============
                Label:
                    text: "📇 RFID Cards"
                    font_size: sp(18)
                    bold: True
                    color: 0.6, 0.9, 1, 1
                    size_hint_y: None
                    height: dp(35)
                    halign: "left"
                    valign: "middle"
                    text_size: self.size

                # Add new card
                BoxLayout:
                    size_hint_y: None
                    height: dp(50)
                    spacing: dp(10)

                    TextInput:
                        id: card_uid
                        hint_text: "Enter new card UID"
                        multiline: False
                        background_color: 1,1,1,0.1
                        foreground_color: 1,1,1,1
                        padding: [dp(15), dp(15)]
                        font_size: sp(14)

                    Button:
                        text: "Add"
                        size_hint_x: 0.3
                        background_normal: ''
                        background_color: 0.2, 0.8, 0.4, 1
                        color: 1, 1, 1, 1
                        font_size: sp(14)
                        bold: True
                        on_release: root.add_card()

                Button:
                    text: "🔄 Refresh Card List"
                    size_hint_y: None
                    height: dp(45)
                    background_normal: ''
                    background_color: 1, 0.7, 0, 1
                    color: 1, 1, 1, 1
                    font_size: sp(14)
                    bold: True
                    on_release: root.refresh_list()

                Label:
                    text: "Authorized Cards:"
                    font_size: sp(16)
                    bold: True
                    color: 1, 1, 1, 1
                    size_hint_y: None
                    height: dp(30)
                    halign: "left"
                    valign: "middle"
                    text_size: self.size

                # Card list container
                BoxLayout:
                    orientation: 'vertical'
                    size_hint_y: None
                    height: dp(150)
                    
                    ScrollView:
                        do_scroll_x: False
                        do_scroll_y: True
                        bar_width: dp(8)

                        GridLayout:
                            id: card_list
                            cols: 1
                            size_hint_y: None
                            height: self.minimum_height
                            spacing: dp(5)

                # ============ FINGERPRINT SECTION ============
                Widget:
                    size_hint_y: None
                    height: dp(20)

                Label:
                    text: "👆 Fingerprints"
                    font_size: sp(18)
                    bold: True
                    color: 0.6, 1, 0.6, 1
                    size_hint_y: None
                    height: dp(35)
                    halign: "left"
                    valign: "middle"
                    text_size: self.size

                # Enroll fingerprint
                BoxLayout:
                    size_hint_y: None
                    height: dp(50)
                    spacing: dp(10)

                    TextInput:
                        id: fp_id_input
                        hint_text: "Fingerprint ID (1-127)"
                        multiline: False
                        input_filter: 'int'
                        background_color: 1,1,1,0.1
                        foreground_color: 1,1,1,1
                        padding: [dp(15), dp(15)]
                        font_size: sp(14)

                    Button:
                        text: "Enroll"
                        size_hint_x: 0.3
                        background_normal: ''
                        background_color: 0.2, 0.8, 0.4, 1
                        color: 1, 1, 1, 1
                        font_size: sp(14)
                        bold: True
                        on_release: root.enroll_fingerprint()

                # Delete fingerprint
                BoxLayout:
                    size_hint_y: None
                    height: dp(50)
                    spacing: dp(10)

                    TextInput:
                        id: fp_del_input
                        hint_text: "Delete by ID"
                        multiline: False
                        input_filter: 'int'
                        background_color: 1,1,1,0.1
                        foreground_color: 1,1,1,1
                        padding: [dp(15), dp(15)]
                        font_size: sp(14)

                    Button:
                        text: "Delete"
                        size_hint_x: 0.3
                        background_normal: ''
                        background_color: 0.9, 0.3, 0.2, 1
                        color: 1, 1, 1, 1
                        font_size: sp(14)
                        bold: True
                        on_release: root.delete_fingerprint()

                BoxLayout:
                    size_hint_y: None
                    height: dp(45)
                    spacing: dp(10)

                    Button:
                        text: "🔄 Refresh FP List"
                        background_normal: ''
                        background_color: 1, 0.7, 0, 1
                        color: 1, 1, 1, 1
                        font_size: sp(14)
                        bold: True
                        on_release: root.refresh_fingerprint_list()

                    Button:
                        text: "🗑️ Clear All"
                        background_normal: ''
                        background_color: 0.7, 0.2, 0.2, 1
                        color: 1, 1, 1, 1
                        font_size: sp(14)
                        bold: True
                        on_release: root.clear_all_fingerprints()

                Label:
                    text: "Stored Fingerprints:"
                    font_size: sp(16)
                    bold: True
                    color: 1, 1, 1, 1
                    size_hint_y: None
                    height: dp(30)
                    halign: "left"
                    valign: "middle"
                    text_size: self.size

                # Fingerprint list container
                BoxLayout:
                    orientation: 'vertical'
                    size_hint_y: None
                    height: dp(80)
                    
                    ScrollView:
                        do_scroll_x: False
                        do_scroll_y: True
                        bar_width: dp(8)

                        GridLayout:
                            id: fingerprint_list
                            cols: 1
                            size_hint_y: None
                            height: self.minimum_height
                            spacing: dp(5)

                # ============ PIN SECTION ============
                Widget:
                    size_hint_y: None
                    height: dp(20)

                Label:
                    text: "🔐 PIN Code"
                    font_size: sp(18)
                    bold: True
                    color: 1, 0.8, 0.4, 1
                    size_hint_y: None
                    height: dp(35)
                    halign: "left"
                    valign: "middle"
                    text_size: self.size

                # Change PIN
                BoxLayout:
                    size_hint_y: None
                    height: dp(50)
                    spacing: dp(10)

                    TextInput:
                        id: new_pin
                        hint_text: "Enter new PIN"
                        password: True
                        multiline: False
                        background_color: 1,1,1,0.1
                        foreground_color: 1,1,1,1
                        padding: [dp(15), dp(15)]
                        font_size: sp(14)

                    Button:
                        text: "Save PIN"
                        size_hint_x: 0.3
                        background_normal: ''
                        background_color: 0.2, 0.6, 0.9, 1
                        color: 1, 1, 1, 1
                        font_size: sp(14)
                        bold: True
                        on_release: root.change_pin()

                # ============ NAVIGATION ============
                Widget:
                    size_hint_y: None
                    height: dp(20)

                Button:
                    text: "⬅ Back to Dashboard"
                    size_hint_y: None
                    height: dp(50)
                    background_normal: ''
                    background_color: 0.3, 0.3, 0.3, 1
                    color: 1, 1, 1, 1
                    font_size: sp(14)
                    bold: True
                    on_release: root.back_to_dashboard()